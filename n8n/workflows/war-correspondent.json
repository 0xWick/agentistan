    {
      "id": "3e8b6d4f-0002-4a51-8d1e-5c2b3f1a0002",
      "name": "Is it the world?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "3e8b6d4f-secret",
              "leftValue": "={{ $json.headers['x-realm-secret'] }}",
              "rightValue": "={{ $env.REALM_SECRET }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "3e8b6d4f-0003-4a51-8d1e-5c2b3f1a0003",
      "name": "Post to Discord",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DISCORD_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ username: \"Nobody's Playing\", embeds: [{ title: $json.body.title, description: $json.body.text, color: $json.body.color, url: $json.body.url, footer: { text: 'Posted by an n8n automation \u00b7 agentistan.umarkhatana.com' } }] }) }}",
        "options": {}
      }
    },
    {
      "id": "3e8b6d4f-0004-4a51-8d1e-5c2b3f1a0004",
      "name": "Tell the world it's posted",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.WORLD_URL }}/internal/news/posted",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Realm-Secret",
              "value": "={{ $env.REALM_SECRET }}"
            },
            {
              "name": "X-N8N-Execution",
              "value": "={{ $execution.id }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ title: $('New story').first().json.body.title }) }}",
        "options": {}
      }
    }
  ],
