{
  "id": "nbpLivingSkies01",
  "name": "Living Skies",
  "active": true,
  "versionId": "5b0e6a86-1f1d-4c2a-9f55-0d7a3c1e0011",
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "meta": {},
  "tags": [],
  "nodes": [
    {
      "id": "84e67d5c-6f19-543e-bc3e-ebd3cf7f6ff4",
      "name": "Every hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "310099aa-adaa-52ad-856b-8062908960ce",
      "name": "Which capitals?",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.WORLD_URL }}/api/era/skies",
        "options": {}
      }
    },
    {
      "id": "59f4b2e9-44ef-5525-8a2b-dfd6106a6b65",
      "name": "Read their skies (Open-Meteo)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://api.open-meteo.com/v1/forecast?latitude={{ $json.places.map((p) => p.lat).join(',') }}&longitude={{ $json.places.map((p) => p.lon).join(',') }}&current=temperature_2m,weather_code,wind_speed_10m",
        "options": {}
      }
    },
    {
      "id": "aed750c3-abc6-5b7a-8e7d-08e85ec8ab39",
      "name": "Send the skies to the world",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.WORLD_URL }}/internal/era/skies",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Realm-Secret",
              "value": "={{ $env.REALM_SECRET }}"
            },
            {
              "name": "X-N8N-Execution",
              "value": "={{ $execution.id }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ places: $('Which capitals?').first().json.places, current: $input.all().flatMap((i) => [].concat(i.json)).map((r) => r.current) }) }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Every hour": {
      "main": [
        [
          {
            "node": "Which capitals?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Which capitals?": {
      "main": [
        [
          {
            "node": "Read their skies (Open-Meteo)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read their skies (Open-Meteo)": {
      "main": [
        [
          {
            "node": "Send the skies to the world",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}