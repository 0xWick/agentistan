{
  "id": "nbpWeatherSync01",
  "name": "Weather Sync",
  "active": true,
  "versionId": "5b0e6a86-1f1d-4c2a-9f55-0d7a3c1e0005",
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "meta": {},
  "tags": [],
  "nodes": [
    {
      "id": "2d9a7c5e-0001-4a51-8d1e-5c2b3f1a0001",
      "name": "Every 15 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      }
    },
    {
      "id": "2d9a7c5e-0002-4a51-8d1e-5c2b3f1a0002",
      "name": "Which cities, which regions?",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.WORLD_URL }}/api/weather",
        "options": {}
      }
    },
    {
      "id": "2d9a7c5e-0003-4a51-8d1e-5c2b3f1a0003",
      "name": "Read four skies (Open-Meteo)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://api.open-meteo.com/v1/forecast?latitude={{ $json.regions.map((r) => r.lat).join(',') }}&longitude={{ $json.regions.map((r) => r.lon).join(',') }}&current=temperature_2m,weather_code,wind_speed_10m",
        "options": {}
      }
    },
    {
      "id": "2d9a7c5e-0004-4a51-8d1e-5c2b3f1a0004",
      "name": "Send the weather to the world",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.WORLD_URL }}/internal/weather",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Realm-Secret",
              "value": "={{ $env.REALM_SECRET }}"
            },
            {
              "name": "X-N8N-Execution",
              "value": "={{ $execution.id }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ source: 'n8n', current: $input.all().flatMap((i) => [].concat(i.json)).map((r) => r.current) }) }}",
        "options": {}
      },
      "executeOnce": true
    }
  ],
  "connections": {
    "Every 15 minutes": {
      "main": [
        [
          {
            "node": "Which cities, which regions?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Which cities, which regions?": {
      "main": [
        [
          {
            "node": "Read four skies (Open-Meteo)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read four skies (Open-Meteo)": {
      "main": [
        [
          {
            "node": "Send the weather to the world",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
