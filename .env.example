# Copy to .env and fill in. Never commit .env. Test networks only.

# Shared secret between the world server and n8n for /internal/* (generate: openssl rand -hex 24)
REALM_SECRET=

# --- AI generals: any OpenAI-compatible API. Leave LLM_API_KEY empty to run on rule-based "standing orders".
# Free key: https://console.groq.com/keys
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_EXTRA={"reasoning_effort":"low"}
# Stay below the Groq free tier (200k tokens/day, 1k requests/day)
MAX_LLM_TOKENS_PER_DAY=180000
MAX_LLM_CALLS_PER_DAY=900
# Gemini instead: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  LLM_MODEL=gemini-2.5-flash  LLM_EXTRA=

# --- Chain. local = Anvil fork of Base Sepolia (no faucet needed). base-sepolia = public testnet.
NETWORK=local
CHAIN_RPC_URL=https://sepolia.base.org
# A brand-new wallet used only on test networks (generate: cast wallet new). Fund it from a Base Sepolia faucet.
DEPLOYER_PRIVATE_KEY=

# --- Game
SCENARIO=demo
# One turn every 30 minutes keeps 24/7 play inside the free AI tier (see README)
TURN_INTERVAL_MS=1800000
PORT=8080
N8N_TURN_WEBHOOK=http://127.0.0.1:5678/webhook/turn

# --- Publishing. QUICK_TUNNEL=1 gives a temporary trycloudflare.com URL; scripts/tunnel.sh sets TUNNEL_NAME for your own domain.
QUICK_TUNNEL=
TUNNEL_NAME=

# --- Footer branding
PUBLIC_OWNER_NAME=
PUBLIC_HIRE_URL=
PUBLIC_REPO_URL=
PUBLIC_CONTACT_EMAIL=
