# Local-only settings for scripts on your machine. Never commit .env. Test networks only.
# The live world's settings are in wrangler.jsonc (vars) and Cloudflare secrets (npx wrangler secret put NAME).

# Shared secret between the world and n8n for /internal/* and the n8n webhooks (generate: openssl rand -hex 24)
REALM_SECRET=

# Free AI key (console.groq.com/keys). Uploaded as a Cloudflare secret; empty = rule-based "standing orders".
LLM_API_KEY=

# A brand-new wallet used only on test networks (generate: cast wallet new). Fund it from a Base Sepolia faucet.
# Used by `npm run deploy:contract` and uploaded as a Cloudflare secret for on-chain receipts.
DEPLOYER_PRIVATE_KEY=
NETWORK=base-sepolia
CHAIN_RPC_URL=https://sepolia.base.org

# Hosting and integrations
CLOUDFLARE_API_TOKEN=    # "Edit Cloudflare Workers" template; lets GitHub Actions deploy on push
RENDER_API_KEY=          # render.com → Account Settings → API Keys; n8n runs there
DISCORD_WEBHOOK_URL=     # Server Settings → Integrations → Webhooks; the War Correspondent posts here
